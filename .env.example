# ─── NVIDIA NIM (Primary Inference) ───────────────────────────────────────────
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_API_KEY="your-nvidia-nim-key-here"

# ─── Experiential Labs (Fallback Inference) ────────────────────────────────────
EXPLABS_BASE_URL="https://api.experientiallabs.ai/v1"
EXPLABS_API_KEY="your-explabs-key-here"

# ─── Azure Document Intelligence (OCR/Extraction) ─────────────────────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://your-resource.cognitiveservices.azure.com/"
AZURE_DOCUMENT_INTELLIGENCE_KEY="your-azure-key-here"

# ─── Local Services (Zero-Cost) ───────────────────────────────────────────────
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
DATABASE_URL="sqlite:///./data/sitesync.db"
CHROMA_PERSIST_DIR="data/chroma_db"

# ─── Auto-configured by benchmark script ──────────────────────────────────────
NVIDIA_DEFAULT_MODEL=""
EXPLABS_FALLBACK_MODEL=""
CONFIDENCE_THRESHOLD=0.85
